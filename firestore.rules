rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - email: string (required) - User's email address
    //   - role: string (required) - User's role ('admin' or 'user')
    //
    // Collection: gameRegions
    // Document ID: north | south
    // Fields:
    //   - layoutOrientation: string (optional) - vertical or horizontal
    //   - totalCheckins: int (optional) - configured check-in total
    //   - giftIssueRate: number (optional) - configured gift issue percentage
    //   - initialInventory: map (optional) - locked starting inventory snapshot
    //   - initialInventoryLockedAt: timestamp or null (optional)
    // Subcollections:
    //   - inventory/{itemId}: gift inventory item
    //   - logs/{logId}: append-only play log
    //
    // Collection: logs
    // Document ID: {logId}
    // Fields:
    //   - timestamp: string (required) - Formatted timestamp
    //   - result: string (required) - Name of the gift
    //   - type: string (required) - Type of the gift or 'none'
    //   - userName: string (required) - User's display name
    //   - userEmail: string (required) - User's email
    //   - userId: string (required) - User's ID
    //   - accountId: string (optional) - Operational account identifier
    //   - createdAt: timestamp (required) - Firestore timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email in [
          "nhanntl18402@gmail.com",
          "vuuloc123@gmail.com",
          "nhannguyen.cellphones@gmail.com"
        ] &&
        request.auth.token.email_verified == true;
    }

    function isKnownRegion(regionId) {
      return regionId in ['north', 'south'];
    }

    function assignedRegion() {
      return request.auth.token.email in [
        'doorgift_mb_1@vhws.local',
        'doorgift_mb_2@vhws.local'
      ] ? 'north' : request.auth.token.email in [
        'doorgift_mn_1@vhws.local',
        'doorgift_mn_2@vhws.local'
      ] ? 'south' : '';
    }

    function canAccessRegion(regionId) {
      return isAdmin() || (isAuthenticated() && assignedRegion() == regionId);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidUser() {
      return hasOnlyAllowedFields(['email', 'role']) &&
             hasRequiredFields(['email', 'role']) &&
             request.resource.data.email is string &&
             request.resource.data.role in ['admin', 'user'];
    }

    function isValidInventoryItem() {
      return hasOnlyAllowedFields(['name', 'count', 'img', 'icon', 'backgroundRemoved']) &&
             hasRequiredFields(['name', 'count', 'img', 'icon']) &&
             request.resource.data.name is string &&
             request.resource.data.count is int &&
             request.resource.data.count >= 0 &&
             request.resource.data.img is string &&
             request.resource.data.icon is string &&
             (!request.resource.data.keys().hasAny(['backgroundRemoved']) ||
              request.resource.data.backgroundRemoved is bool);
    }

    function isPlayerDecrement() {
      return isAuthenticated() &&
             isValidInventoryItem() &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
             request.resource.data.count == resource.data.count - 1;
    }

    function isValidLogEntry() {
      return hasOnlyAllowedFields(['timestamp', 'result', 'type', 'userName', 'userEmail', 'userId', 'accountId', 'userPhotoURL', 'regionId', 'createdAt']) &&
             hasRequiredFields(['timestamp', 'result', 'type', 'userName', 'userEmail', 'userId', 'createdAt']) &&
             request.resource.data.timestamp is string &&
             request.resource.data.result is string &&
             request.resource.data.type is string &&
             request.resource.data.userName is string &&
             request.resource.data.userEmail is string &&
             request.resource.data.userId is string &&
             (!request.resource.data.keys().hasAny(['accountId']) || request.resource.data.accountId is string) &&
             (!request.resource.data.keys().hasAny(['userPhotoURL']) || request.resource.data.userPhotoURL is string) &&
             (!request.resource.data.keys().hasAny(['regionId']) || request.resource.data.regionId in ['north', 'south']) &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidRegionSettings() {
      return hasOnlyAllowedFields(['layoutOrientation', 'totalCheckins', 'giftIssueRate', 'initialInventory', 'initialInventoryLockedAt']) &&
             (!request.resource.data.keys().hasAny(['layoutOrientation']) || request.resource.data.layoutOrientation in ['vertical', 'horizontal']) &&
             (!request.resource.data.keys().hasAny(['totalCheckins']) || (request.resource.data.totalCheckins is int && request.resource.data.totalCheckins >= 0)) &&
             (!request.resource.data.keys().hasAny(['giftIssueRate']) || (request.resource.data.giftIssueRate is number && request.resource.data.giftIssueRate >= 0 && request.resource.data.giftIssueRate <= 100)) &&
             (!request.resource.data.keys().hasAny(['initialInventory']) || request.resource.data.initialInventory == null || request.resource.data.initialInventory is map) &&
             (!request.resource.data.keys().hasAny(['initialInventoryLockedAt']) || request.resource.data.initialInventoryLockedAt == null || request.resource.data.initialInventoryLockedAt is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser() &&
                    (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin() && isValidUser();
      allow delete: if isAdmin();
    }

    match /game/inventory {
      allow read, write: if false;
    }

    match /game/inventory/items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidInventoryItem();
      allow update: if (isAdmin() && isValidInventoryItem()) || isPlayerDecrement();
      allow delete: if isAdmin();
    }

    match /game/settings {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /gameRegions/{regionId} {
      allow read: if isKnownRegion(regionId) && canAccessRegion(regionId);
      allow create, update: if isKnownRegion(regionId) && isAdmin() && isValidRegionSettings();
      allow delete: if false;

      match /inventory/{itemId} {
        allow read: if isKnownRegion(regionId) && canAccessRegion(regionId);
        allow create: if isKnownRegion(regionId) && isAdmin() && isValidInventoryItem();
        allow update: if (isKnownRegion(regionId) && isAdmin() && isValidInventoryItem()) ||
                      (isKnownRegion(regionId) && isAuthenticated() && assignedRegion() == regionId && isPlayerDecrement());
        allow delete: if isKnownRegion(regionId) && isAdmin();
      }

      match /logs/{logId} {
        allow read: if isKnownRegion(regionId) && isAdmin();
        allow create: if isKnownRegion(regionId) && canAccessRegion(regionId) &&
                      isValidLogEntry() &&
                      request.resource.data.regionId == regionId &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.userEmail == request.auth.token.email;
        allow update: if false;
        allow delete: if isKnownRegion(regionId) && isAdmin();
      }
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
                    isValidLogEntry() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.userEmail == request.auth.token.email;
      allow update: if false; // Logs are append-only
      allow delete: if isAdmin(); // Allow admin to clear logs
    }
  }
}
